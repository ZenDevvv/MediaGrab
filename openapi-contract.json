    "/api/open-folder": {
      "post": {
        "description": "Reveal the output directory in the OS file manager (desktop only).\n\nHosted has no local filesystem to reveal, and there is no path a browser\ncould be pointed at, so this refuses rather than pretending to succeed.",
        "operationId": "api_open_folder_api_open_folder_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
