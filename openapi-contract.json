          },
          "trim": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TrimConfig"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "DownloadRequest",
        "type": "object"
      },
      "DownloadResponse": {
        "properties": {
          "job_id": {
            "title": "Job Id",
            "type": "string"
          }
