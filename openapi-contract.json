  "info": {
    "description": "Lightweight self-hosted media downloader, trimmer, and converter (PWA)",
    "title": "MediaGrab",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/abort/{job_id}": {
      "post": {
        "description": "Cancel an in-flight job and purge whatever it has written so far.",
        "operationId": "api_abort_api_abort__job_id__post",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Api Abort"
      }
    },
    "/api/capabilities": {
      "get": {
        "description": "Single source of truth for what this deployment allows and offers.",
        "operationId": "api_capabilities_api_capabilities_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Api Capabilities"
      }
    },
    "/api/diagnostics/log": {
      "get": {
        "description": "Return the launcher log tail and where the file lives.\n\nOnly the tail is returned: the file grows without bound and a failed run is\nalways at the end.",
        "operationId": "api_diagnostics_log_api_diagnostics_log_get",
        "parameters": [
          {
            "in": "query",
            "name": "tail_bytes",
            "required": false,
            "schema": {
              "default": 200000,
              "maximum": 5000000,
              "minimum": 1024,
              "title": "Tail Bytes",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Api Diagnostics Log"
      }
    },
    "/api/diagnostics/open-log": {
      "post": {
        "description": "Reveal launcher.log in the OS default application.",
        "operationId": "api_diagnostics_open_log_api_diagnostics_open_log_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Api Diagnostics Open Log"
      }
    },
    "/api/diagnostics/update-check": {
      "get": {
        "description": "Compare the running build against the newest GitHub release.\n\nGoes through the server rather than the browser so it works identically in\nthe packaged app, where the page is served from a loopback address and the\nrelease API would be a cross-origin request.",
        "operationId": "api_diagnostics_update_check_api_diagnostics_update_check_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Api Diagnostics Update Check"
      }
    },
