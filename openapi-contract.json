            "title": "Title",
            "type": "string"
          },
          "uploader": {
            "title": "Uploader",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "title",
          "uploader",
          "duration"
