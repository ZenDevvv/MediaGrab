          "retention_seconds": {
            "title": "Retention Seconds",
            "type": "integer"
          },
          "version": {
            "default": "dev",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "mode",
          "retention_seconds",
          "limits",
          "downloads"
        ],
        "title": "CapabilitiesResponse",
        "type": "object"
