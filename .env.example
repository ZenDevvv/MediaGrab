# Copy to .env and fill in real values. NEVER commit .env -- it is gitignored.

# --- Freestyle (hosted VM access) ---------------------------------------
# Obtain from the Freestyle dashboard, or run: npx freestyle@latest login
FREESTYLE_API_KEY=
VM_ID=vm-4ea425a9eae64c4bacd5fde0b2d9a99d
TEAM_ID=acct-00a8ab64d7974b278232fad8bf8b95c0

# --- Application ---------------------------------------------------------
# Required in production. If unset, one is generated per process, which means
# every restart resets each user's concurrency-gate history.
# Generate with: head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
SESSION_SECRET=

# Only enable when traffic genuinely arrives via a proxy you control.
# If true without a trusted proxy, clients can forge X-Forwarded-For and
# bypass the per-IP rate limit entirely.
BEHIND_PROXY=false

# --- YouTube extraction on a hosted (datacenter) IP ------------------------
# YouTube answers "Sign in to confirm you're not a bot" from datacenter IPs
# regardless of player client or JS runtime. Measured on the hosted VM:
# 1 of 4 videos succeeded without help; TLS impersonation made it worse.
#
# Lever 1 -- cookies (free, temporary). Export from a real browser session:
#   yt-dlp --cookies-from-browser chrome --cookies cookies.txt <any-url>
# then: scp cookies.txt <vm>:/tmp/ && bash deploy/install-cookies.sh install /tmp/cookies.txt
# NOTE: YouTube binds cookies to the address they came from, so cookies made
# on your home network may not authenticate the VM.
#
# Lever 2 -- residential egress (costs money, the only reliable fix):
# MEDIA_GRAB_YTDLP_PROXY=socks5://user:pass@host:1080

# MEDIA_GRAB_YTDLP_COOKIES=/etc/mediagrab/ytdlp-cookies.txt
# MEDIA_GRAB_YTDLP_PROXY=

# Player clients: web/mweb need a Proof-of-Origin token and are excluded.
YTDLP_PLAYER_CLIENTS=tv_embedded,default,android_vr
# JS runtime for the player challenge (yt-dlp deprecates extraction without one)
YTDLP_JS_RUNTIMES=deno

# --- Mode ----------------------------------------------------------------
# desktop = unlimited, files kept; hosted = guarded, zero retention.
MEDIAGRAB_MODE=hosted

# Set true once desktop binaries are published to GitHub releases. Until then
# download links point at the /downloads "coming soon" page.
DOWNLOADS_AVAILABLE=false
# Which platforms CI actually builds. Keep in lockstep with the jobs in
# .github/workflows/build-desktop.yml; an unlisted platform keeps pointing at
# DOWNLOADS_COMING_SOON_URL instead of advertising an asset that cannot exist.
DOWNLOADS_PUBLISHED=windows,linux
GITHUB_RELEASES_URL=https://github.com/ZenDevvv/MediaGrab/releases/latest

# --- YouTube posture (hosted only) ------------------------------------------
# YouTube refuses this platform's datacenter address for most videos. The server
# therefore makes at most one outbound YouTube request per cooldown window and
# answers everything else locally. Retry loops are what escalate a challenge
# into a hard block, so raising this only slows detection.
MEDIA_GRAB_YOUTUBE_COOLDOWN_SECONDS=1800

# --- Build identification (desktop) -----------------------------------------
# Stamped from the tag at package time; the settings panel's update check
# compares it against the latest GitHub release. "dev" outside CI.
MEDIA_GRAB_VERSION=dev
# Repository the update check queries.
MEDIA_GRAB_GITHUB_REPO=ZenDevvv/MediaGrab